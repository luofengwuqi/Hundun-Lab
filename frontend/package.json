{
  "name": "hundun-front",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "run-s lint:oxlint lint:format lint:i18n lint:color",
    "lint:oxlint": "oxlint . --fix",
    "lint:format": "prettier --check src/",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "lint:color": "node scripts/check-color.mjs",
    "lint:baseline": "node scripts/check-i18n.mjs --update && node scripts/check-color.mjs --update",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.21.1",
    "element-plus": "^2.14.8",
    "pinia": "^3.0.4",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.4",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.91.0",
    "prettier": "3.8.1",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^29.2.0",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
