# ---------- 构建产物 ----------
target/
dist/
dist-ssr/
node_modules/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# ---------- 依赖与构建缓存 ----------
.oxlintcache
.eslintcache
*.tsbuildinfo
.vite/
__screenshots__/
*.timestamp-*-*.mjs
__pycache__/
*.pyc

# logo 构建脚本的中间物：源图与字体体积大且可用公开渠道重新获取，
# 入库只保留可复现的脚本（*.py）与产出（svg/png）。
# 需要重新构建时：把字体丢回 docs/design/logo/_build/fonts/ 再跑 build.py
docs/design/logo/_build/fonts/*.ttf
docs/design/logo/_build/assets.json

# ---------- IDE ----------
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
workspace.xml
/dataSources/
/dataSources.local.xml
/httpRequests/
/shelf/
.suo
*.njsproj
*.sln
*.sw?

# ---------- 日志与临时文件 ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.local
coverage/

# ---------- 敏感配置（任何密钥都不得入库） ----------
application-secret.yml
**/application-secret.yml
*.local.yml
.env
.env.*
!.env.example

# ---------- 本机工具数据 ----------
.workbuddy/
